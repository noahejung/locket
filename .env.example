LOCKET_CORPUS_DIR=C:\path\to\your\exports   # NEVER inside the repo
LOCKET_DB_URL=postgresql://locket:locket@127.0.0.1:5432/locket
# POSTGRES_PASSWORD=locket                  # read by docker-compose.yml itself (project .env, not LOCKET_DB_URL) -- override the dev-default password here; keep LOCKET_DB_URL's password in sync if you do
ANTHROPIC_API_KEY=sk-ant-...
LOCKET_OLLAMA_MODEL=qwen3-vl:8b            # vision-LLM tail model (locket.vision.vision_llm) -- always local, unaffected by LOCKET_LLM_BACKEND below

# Text-extraction/resolution/profile/answer_question backend (locket.llm). Leave both unset
# to auto-select: "ollama" (fully local, keyless) if ANTHROPIC_API_KEY is unset above, else
# "anthropic". See README's "Running fully local" section.
# LOCKET_LLM_BACKEND=ollama                # "anthropic" | "ollama"
# LOCKET_LOCAL_MODEL=gemma3:12b            # local Ollama TEXT model when backend=ollama (needs `ollama pull gemma3:12b`, ~8GB)

# LOCKET_IOS_BACKUP_PASSPHRASE=...          # only needed for an ENCRYPTED iPhone backup (auto-detected via Manifest.plist) -- `locket ingest <backup-dir> --passphrase ...` also works and takes precedence. The common unencrypted-backup path needs neither.
